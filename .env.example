# Base URL of the Guarde-Back API. Port 8001 because 8000 is often taken by
# other local projects — run this app's backend with: php artisan serve --port=8001
# - iOS Simulator: http://localhost:8001
# - Android Emulator: http://10.0.2.2:8001
# - Physical device (Expo Go): http://<your-machine-lan-ip>:8001
EXPO_PUBLIC_API_URL=http://localhost:8001
