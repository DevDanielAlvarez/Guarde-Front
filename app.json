{
  "expo": {
    "name": "Guarde-Front",
    "slug": "Guarde-Front",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/branding/logo.png",
    "scheme": "guardefront",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.danielalvarez.guardefront",
      "adaptiveIcon": {
        "backgroundColor": "#0A84FF",
        "foregroundImage": "./assets/images/branding/logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-navigation-bar",
        {
          "hidden": true
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e6ef4c61-aeb8-499d-af6e-1e00c276ca3e"
      }
    },
    "owner": "daniel200412"
  }
}
